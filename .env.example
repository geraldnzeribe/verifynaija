# Copy to .env for local runs; set the same names in Vercel > Project > Settings > Environment Variables.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
NEAR_NETWORK=testnet
# The account that owns the contract and relays reports (pays gas so shoppers need no wallet)
NEAR_ACCOUNT_ID=
NEAR_CONTRACT_ID=
# ed25519:... from ~/.near-credentials/testnet/<account>.json  (never commit this)
NEAR_PRIVATE_KEY=
